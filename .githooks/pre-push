#!/bin/sh
set -eu

# Git supplies one line per ref. Deletions have no local object to validate.
head=$(git rev-parse HEAD)
check=false
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_ref" in '(delete)') continue ;; esac
  if ! commit=$(git rev-parse --verify "$local_oid^{commit}") || [ "$commit" != "$head" ]; then
    echo "pre-push: $local_ref is not at the checked-out commit; check it out before pushing." >&2
    exit 1
  fi
  check=true
done
[ "$check" = true ] || exit 0

status=$(git status --porcelain --untracked-files=normal)
if [ -n "$status" ]; then
  echo 'pre-push: commit or set aside local changes so checks run against the pushed source.' >&2
  exit 1
fi

exec npm run check
